+@available(macOS 26.0, *)
+private final class ModernPixelWriter {
+  let receiver: AVAssetWriterInput.PixelBufferReceiver
+  private let metricsLock = NSLock()
+  private var immediateSeconds = 0.0, suspendedSeconds = 0.0
+  private var immediateCount = 0, suspendedCount = 0
+  var metrics: (Double, Double, Int) {
+    metricsLock.lock(); defer { metricsLock.unlock() }
+    return (immediateSeconds * 1000 / Double(max(1, immediateCount)), suspendedSeconds, suspendedCount)
+  }
+  init(writer: AVAssetWriter, input: AVAssetWriterInput, width: Int, height: Int) {
+    var attributes = CVPixelBufferCreationAttributes(
+      pixelFormatType: .init(rawValue: kCVPixelFormatType_32BGRA),
+      size: .init(width: width, height: height), compatibility: [.metalTexture])
+    attributes.backing = .ioSurface
+    receiver = writer.inputPixelBufferReceiver(for: input, pixelBufferAttributes: attributes)
+  }
+  func allocate() throws -> CVPixelBuffer {
+    guard let pool = receiver.pixelBufferPool else { throw StudioError.message("缺少接收器像素池") }
+    let mutable = try pool.makeMutablePixelBuffer(.init(allocationThreshold: 12))
+    // The private producer owns this retained CF reference until GPU completion.
+    // It becomes read-only only when append is called; no later GPU write aliases it.
+    return mutable.withUnsafeBuffer { $0 }
+  }
+  func appendImmediately(_ pixel: CVPixelBuffer, time: CMTime) throws -> Bool {
+    try appendImmediately(CVReadOnlyPixelBuffer(unsafeBuffer: pixel), time: time)
+  }
+  private func appendImmediately(_ immutable: CVReadOnlyPixelBuffer, time: CMTime) throws -> Bool {
+    let begin = ProcessInfo.processInfo.systemUptime
+    let accepted = try receiver.appendImmediately(immutable, with: time)
+    let elapsed = ProcessInfo.processInfo.systemUptime - begin
+    metricsLock.lock(); immediateSeconds += elapsed; immediateCount += 1; metricsLock.unlock()
+    return accepted
+  }
+  func append(_ pixel: CVPixelBuffer, time: CMTime) async throws {
+    let immutable = CVReadOnlyPixelBuffer(unsafeBuffer: pixel)
+    if try !appendImmediately(immutable, time: time) {
+      let begin = ProcessInfo.processInfo.systemUptime
+      try await receiver.append(immutable, with: time)
+      let elapsed = ProcessInfo.processInfo.systemUptime - begin
+      metricsLock.withLock { suspendedSeconds += elapsed; suspendedCount += 1 }
+    }
+  }
+}
